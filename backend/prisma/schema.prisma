
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  isGuest Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Session {
  id String @id 
  sid String @unique
  data String @db.Text

  createdAt DateTime @default(now())
  expiresAt DateTime
}